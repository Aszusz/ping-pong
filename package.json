{
  "name": "ping-pong",
  "private": true,
  "type": "module",
  "scripts": {
    "db:push": "pnpm --filter @ping-pong/api exec drizzle-kit push",
    "dev:api": "pnpm --filter @ping-pong/api dev",
    "dev:web": "pnpm --filter @ping-pong/web dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "qual": "pnpm format && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
