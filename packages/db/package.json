{
  "name": "@ping-pong/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "drizzle-kit": "drizzle-kit",
    "push": "pnpm run push:dev && pnpm run push:test",
    "push:dev": "dotenv -e ../../.env -- drizzle-kit push",
    "push:test": "dotenv -e ../../.env -- drizzle-kit push --config drizzle.config.test.ts",
    "generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.39",
    "pg": "^8"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/pg": "^8",
    "drizzle-kit": "^0.31",
    "typescript": "^5"
  }
}
